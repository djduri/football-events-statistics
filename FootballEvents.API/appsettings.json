{
  "DatabaseSettings": {
    "ConnectionString": "Data Source=football_events.db",
    //"ConnectionString": "Server=localhost;Port=5432;Database=swifttap_local;User Id=duri;Password=Haslo123!; Pooling=true; Include Error Detail=true",
    "AutoMigrate": true
  },
  "CorsSettings": {
    "Origins": [],
    "Methods": [ "GET", "POST", "DELETE", "PUT", "PATCH", "OPTIONS" ],
    "Headers": [],
    "AllowCredentials": true,
    "AllowWildcardOrigins": false
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Enrichers.Environment" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/football-events/football-events-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} ({MachineName}) [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AuthenticationSettings": {
    "IsDevelopment": true,
    "JwtSecret": "43870f7sdf03480er7fshfg3780rfsdfuysiyfg8023uyszgdf8073guiyfgdfv87934gfyuiasf23087tf8astf87023fakjgfjg2873fjkdsgf21a",
    "RefreshTokenExpirationDays": 30,
    "TokenExpirationMinutes": 43200,
    "TwoFactorCodeExpirationMinutes": 10,
    "Issuer": [],
    "Audience": []
  },  
  "BackgroundJobsSettings": {
    "IsEnabled": true,
    "ConnectionString": "Server=host.docker.internal;Port=5432;Database=swift_tap_local;User Id=admin;Password=haslo123; Pooling=true; Include Error Detail=true",
    "IsDashboardEnabled": true,
    "CronJobSchedules": {
      "RefreshTokenExpiredCleanupSchedule": "0 3 * * 1/2"
    }
  },  
  "AllowedHosts": "*"
}